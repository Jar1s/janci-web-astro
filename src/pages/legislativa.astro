---

<MainLayout
  title="Platná legislatíva | STK JP Control Pezinok"
  description="Zákony, vyhlášky a metodické pokyny v oblasti kontroly vozidiel. Kompletný prehľad platnej legislatívy pre technickú kontrolu, emisnú kontrolu a kontrolu originality."
  canonical="/legislativa"
>
  <Header slot="header" currentPath="/legislativa" />

  <Hero
    title="Platná legislatíva"
    subtitle="Zákony, vyhlášky a metodické pokyny v oblasti kontroly vozidiel"
    ctaText="KONTAKTOVAŤ NÁS"
    ctaHref="/kontakt"
  />

  <!-- Section 1: Zákon -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-5">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-primary mb-4" data-translate="legislation-law-title">Zákon</h2>
        <div class="w-16 h-1 bg-primary mx-auto rounded-full"></div>
      </div>
      <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200 shadow-sm">
        <p class="text-slate-700 text-lg leading-relaxed text-center font-medium">
          <a href={law.href} class={linkClass} target="_blank" rel="noopener noreferrer">{law.label}</a> {law.text}
        </p>
      </div>
    </div>
  </section>

  <!-- Section 2: Vykonávacie vyhlášky -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-4xl mx-auto px-5">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-primary mb-4" data-translate="legislation-decree-title">Vykonávacie vyhlášky</h2>
        <div class="w-16 h-1 bg-primary mx-auto rounded-full"></div>
        <p class="text-slate-500 mt-4 max-w-2xl mx-auto">Vyhláška Ministerstva dopravy a výstavby Slovenskej republiky:</p>
      </div>
      <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
        <ul class="space-y-3">
          {decrees.map((decree) => (
            <li class:list={[
              'flex gap-3 items-start',
              decree.highlight ? 'text-slate-700 bg-primary/5 border-l-4 border-primary rounded-r-lg p-3 -ml-3 font-semibold' : 'text-slate-600',
            ]}>
              <span class="text-primary mt-1 shrink-0">&#9679;</span>
              <span>
                <a href={decree.href} class={linkClass} target="_blank" rel="noopener noreferrer">{decree.label}</a>, {decree.text}
                {decree.highlight ? <> <strong class="text-primary">{decree.highlight}</strong>,</> : null}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Section 3: Metodické pokyny - Technická kontrola -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-5">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-primary mb-4" data-translate="legislation-tk-methods-title">Metodické pokyny - Technická kontrola</h2>
        <div class="w-16 h-1 bg-primary mx-auto rounded-full"></div>
        <p class="text-slate-500 mt-4 max-w-2xl mx-auto">Metodický pokyn Ministerstva dopravy a výstavby Slovenskej republiky v oblasti <strong>TECHNICKEJ KONTROLY</strong>:</p>
      </div>
      <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200 shadow-sm">
        <ul class="space-y-3">
          {tkMethods.map((method) => (
            <li class="flex gap-3 items-start text-slate-600">
              <span class="text-primary mt-1 shrink-0">&#9679;</span>
              <span>
                <a href={method.href} class={linkClass} target="_blank" rel="noopener noreferrer">{method.label}</a>{methodSeparator(method.html)}
                <span set:html={method.html} />
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Section 4: Metodické pokyny - Emisná kontrola -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-4xl mx-auto px-5">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-primary mb-4" data-translate="legislation-ek-methods-title">Metodické pokyny - Emisná kontrola</h2>
        <div class="w-16 h-1 bg-primary mx-auto rounded-full"></div>
        <p class="text-slate-500 mt-4 max-w-2xl mx-auto">Metodický pokyn Ministerstva dopravy a výstavby Slovenskej republiky v oblasti <strong>EMISNEJ KONTROLY</strong>:</p>
      </div>
      <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-sm">
        <ul class="space-y-3">
          {ekMethods.map((method) => (
            <li class="flex gap-3 items-start text-slate-600">
              <span class="text-primary mt-1 shrink-0">&#9679;</span>
              <span>
                <a href={method.href} class={linkClass} target="_blank" rel="noopener noreferrer">{method.label}</a>{methodSeparator(method.html)}
                <span set:html={method.html} />
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</MainLayout>
