---
import MainLayout from '@/layouts/MainLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
const recaptchaSiteKey = String(import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY || '');
const recaptchaMode = String(import.meta.env.PUBLIC_RECAPTCHA_MODE || 'v3').toLowerCase() === 'v2' ? 'v2' : 'v3';
---

<MainLayout
  title="Rezervácia termínu | STK JP Control Pezinok"
  description="Online rezervácia termínu pre technickú, emisnú kontrolu alebo kontrolu originality."
  canonical="/rezervacia"
>
  <Header slot="header" currentPath="/rezervacia" />
  <h1 class="sr-only" data-translate="booking-title">Rezervácia termínu</h1>

  <section class="booking-page">
    <div class="booking-container">
      <header class="booking-head">
        <h2 data-translate="booking-title">Rezervácia termínu</h2>
        <p data-translate="booking-subtitle">Vyberte službu, kliknite na voľný termín v tabuľke a vyplňte kontaktné údaje.</p>
        <p class="booking-ko-notice">
          <strong data-translate="booking-ko-notice-strong" data-translate-html>REZERVOVANIE NA KONTROLU ORIGINALITY (KO) JE MOŽNÉ IBA TELEFONICKY NA <a href="tel:+421948888088">0948 888 088</a></strong>
          <span data-translate="booking-ko-notice-text">Vyberte termín, ktorý Vám vyhovuje, vyplne formulár a odošlite. Budeme Vás späťne kontaktovať telefonicky, hneď ako to bude možné.</span>
        </p>
      </header>

      <form id="booking-form" class="booking-form">
        <div class="booking-toolbar">
          <label class="booking-field">
            <span data-translate="booking-service-label">Služba *</span>
            <select id="serviceType" name="serviceType" required>
              <option value="tk_ek" data-translate="booking-service-option-tkek">Technická / emisná kontrola</option>
              <option value="ko" data-translate="booking-service-option-ko">Kontrola originality</option>
            </select>
          </label>

          <label class="booking-field">
            <span data-translate="booking-range-start-label">Začiatok dátumového rozhrania *</span>
            <input id="rangeStartDate" name="rangeStartDate" type="date" required />
          </label>
        </div>

        <div class="booking-scheduler">
          <div class="booking-scheduler-head">
            <p class="booking-range-label" data-translate="booking-range-label">Dátumové rozhranie (8 dní vedľa seba):</p>
            <div class="booking-range-controls">
              <button id="booking-prev-range" type="button" class="booking-range-btn" data-translate="booking-range-prev">← Predchádzajúcich 8 dní</button>
              <span id="booking-current-range" class="booking-range-current"></span>
              <button id="booking-next-range" type="button" class="booking-range-btn" data-translate="booking-range-next">Ďalších 8 dní →</button>
            </div>
          </div>
          <div class="booking-legend" aria-label="Legenda dostupnosti termínov" data-translate-aria="booking-legend-aria">
            <span class="booking-legend-item booking-legend-item--free" data-translate="booking-status-free">VOĽNÉ</span>
            <span class="booking-legend-item booking-legend-item--busy" data-translate="booking-status-busy">OBSADENÉ</span>
            <span class="booking-legend-item booking-legend-item--closed" data-translate="booking-status-closed">ZATVORENÉ</span>
          </div>

          <div class="booking-table-wrap">
            <table class="booking-table">
              <thead id="booking-table-head"></thead>
              <tbody id="booking-table-body"></tbody>
            </table>
          </div>

          <div class="booking-mobile-scheduler">
            <p class="booking-mobile-scheduler__label" data-translate="booking-mobile-days-label">Dni v rozsahu:</p>
            <div id="booking-mobile-days" class="booking-mobile-days" role="tablist" aria-label="Dni termínov"></div>
            <p class="booking-mobile-scheduler__label" data-translate="booking-mobile-slots-label">Voľné termíny pre vybraný deň:</p>
            <div id="booking-mobile-slots" class="booking-mobile-slots"></div>
          </div>
        </div>

        <p id="booking-inline-msg" class="booking-msg" hidden></p>

        <input type="hidden" id="slotId" name="slotId" />
        <input type="hidden" id="slotStartAt" name="slotStartAt" />

        <div id="booking-modal" class="booking-modal" hidden aria-hidden="true">
          <div id="booking-modal-backdrop" class="booking-modal__backdrop"></div>
          <div class="booking-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="booking-modal-title">
            <div class="booking-modal__head">
              <h3 id="booking-modal-title" data-translate="booking-modal-title">Dokončenie rezervácie</h3>
              <button id="booking-modal-close" type="button" class="booking-modal__close" aria-label="Zavrieť formulár" data-translate-aria="booking-modal-close-aria">×</button>
            </div>

            <p id="selected-slot" class="selected-slot" data-translate="booking-selected-slot-empty">Vybraný termín: žiadny</p>

            <div class="booking-grid">
              <label class="booking-field">
                <span data-translate="booking-check-label">Kontrola *</span>
                <select id="serviceTypeModal" name="serviceTypeModal" required>
                  <option value="tk_ek" data-translate="booking-check-option-tkek">EK+TK</option>
                  <option value="ek" data-translate="booking-check-option-ek">EK</option>
                  <option value="tk" data-translate="booking-check-option-tk">TK</option>
                </select>
              </label>

              <label class="booking-field">
                <span data-translate="booking-inspection-type-label">Typ kontroly *</span>
                <select id="inspectionType" name="inspectionType" required>
                  <option value="pravidelna" data-translate="booking-inspection-type-regular">pravidelná</option>
                  <option value="opakovana" data-translate="booking-inspection-type-repeated">opakovaná</option>
                  <option value="administrativna" data-translate="booking-inspection-type-administrative">administratívna</option>
                  <option value="zvlastna" data-translate="booking-inspection-type-special">zvláštna</option>
                </select>
              </label>

              <label class="booking-field booking-field--full">
                <span data-translate="booking-name-label">Meno a priezvisko/Názov firmy *</span>
                <input id="name" name="name" required minlength="2" maxlength="120" />
              </label>

              <label class="booking-field">
                <span data-translate="booking-phone-label">Telefón *</span>
                <input id="phone" name="phone" required minlength="6" maxlength="32" />
              </label>

              <label class="booking-field">
                <span data-translate="booking-email-label">E-mail</span>
                <input id="email" name="email" type="email" maxlength="180" />
              </label>

              <label class="booking-field">
                <span data-translate="booking-plate-label">EČV</span>
                <input id="vehiclePlate" name="vehiclePlate" maxlength="20" />
              </label>

              <label class="booking-field">
                <span data-translate="booking-vehicle-type-label">Druh vozidla</span>
                <select id="vehicleType" name="vehicleType">
                  <option value="" data-translate="booking-vehicle-type-empty">vyberte druh vozidla</option>
                  <option value="osobne" data-translate="booking-vehicle-type-passenger">osobné vozidlo</option>
                  <option value="nakladne" data-translate="booking-vehicle-type-truck">nákladné vozidlo</option>
                  <option value="tahac" data-translate="booking-vehicle-type-tractor-unit">ťahač</option>
                  <option value="naves" data-translate="booking-vehicle-type-semitrailer">náves</option>
                  <option value="vozik-o1-o2" data-translate="booking-vehicle-type-trailer-o1o2">vozík (O1, O2)</option>
                  <option value="motocykel" data-translate="booking-vehicle-type-motorcycle">motocykel</option>
                  <option value="autobus" data-translate="booking-vehicle-type-bus">autobus</option>
                  <option value="traktor" data-translate="booking-vehicle-type-tractor">traktor</option>
                </select>
              </label>

              <label class="booking-field booking-field--full">
                <span data-translate="booking-vehicle-model-label">Značka a typ vozidla</span>
                <input id="vehicleModel" name="vehicleModel" maxlength="120" />
              </label>

              <label class="booking-field">
                <span data-translate="booking-fuel-type-label">Druh paliva</span>
                <select id="fuelType" name="fuelType">
                  <option value="" data-translate="booking-fuel-type-empty">vyberte druh paliva</option>
                  <option value="benzin" data-translate="booking-fuel-type-petrol">benzín</option>
                  <option value="nafta" data-translate="booking-fuel-type-diesel">nafta</option>
                  <option value="benzin-lpg" data-translate="booking-fuel-type-petrol-lpg">benzín+LPG</option>
                  <option value="benzin-cng" data-translate="booking-fuel-type-petrol-cng">benzín+CNG</option>
                  <option value="lpg">LPG</option>
                  <option value="cng">CNG</option>
                  <option value="hybrid" data-translate="booking-fuel-type-hybrid">hybrid</option>
                  <option value="elektrika" data-translate="booking-fuel-type-electric">elektrika</option>
                  <option value="ine" data-translate="booking-fuel-type-other">iné</option>
                  <option value="bez" data-translate="booking-fuel-type-none">bez</option>
                </select>
              </label>

              <label class="booking-field">
                <span data-translate="booking-vin-label">VIN</span>
                <input id="vehicleVin" name="vehicleVin" maxlength="32" />
              </label>

              <label class="booking-field booking-field--full">
                <span data-translate="booking-note-label">Poznámka</span>
                <textarea id="note" name="note" maxlength="1000" rows="4"></textarea>
              </label>
            </div>

            <p class="booking-note" data-translate="booking-note-help">
              Pri kontrole originality (KO) odporúčame po odoslaní rezervácie počkať na telefonické potvrdenie.
            </p>

            <p id="booking-msg" class="booking-msg" hidden></p>

            {recaptchaSiteKey && recaptchaMode === 'v2' && (
              <div class="booking-recaptcha-wrap">
                <span class="booking-recaptcha-label" data-translate="booking-recaptcha-label">Bezpečnostné overenie *</span>
                <div class="g-recaptcha" data-sitekey={recaptchaSiteKey}></div>
              </div>
            )}

            {recaptchaSiteKey && recaptchaMode === 'v3' && (
              <p class="booking-recaptcha-note" data-translate="booking-recaptcha-note">
                Formulár je chránený službou reCAPTCHA v3.
              </p>
            )}

            <button id="booking-submit" type="submit" class="booking-submit" data-translate="booking-submit">Odoslať rezerváciu</button>
          </div>
        </div>
      </form>
    </div>
  </section>

  <Footer slot="footer" />
</MainLayout>

{recaptchaSiteKey && recaptchaMode === 'v3' && (
  <script src={`https://www.google.com/recaptcha/api.js?render=${encodeURIComponent(recaptchaSiteKey)}`} async defer></script>
)}

{recaptchaSiteKey && recaptchaMode === 'v2' && (
  <script src="https://www.google.com/recaptcha/api.js" async defer></script>
)}

<script is:inline>
  const RECAPTCHA_SITE_KEY = {JSON.stringify(recaptchaSiteKey)};
  const RECAPTCHA_MODE = {JSON.stringify(recaptchaMode)};
  const form = document.getElementById('booking-form');
  const message = document.getElementById('booking-msg');
  const inlineMessage = document.getElementById('booking-inline-msg');
  const submitBtn = document.getElementById('booking-submit');
  const slotInput = document.getElementById('slotId');
  const slotStartInput = document.getElementById('slotStartAt');
  const serviceSelect = document.getElementById('serviceType');
  const rangeStartInput = document.getElementById('rangeStartDate');
  const serviceTypeModal = document.getElementById('serviceTypeModal');
  const prevRangeBtn = document.getElementById('booking-prev-range');
  const nextRangeBtn = document.getElementById('booking-next-range');
  const currentRangeLabel = document.getElementById('booking-current-range');
  const selectedSlotText = document.getElementById('selected-slot');
  const bookingModal = document.getElementById('booking-modal');
  const bookingModalClose = document.getElementById('booking-modal-close');
  const bookingModalBackdrop = document.getElementById('booking-modal-backdrop');
  const bookingModalDialog = bookingModal?.querySelector('.booking-modal__dialog');
  const tableHead = document.getElementById('booking-table-head');
  const tableBody = document.getElementById('booking-table-body');
  const mobileDaysContainer = document.getElementById('booking-mobile-days');
  const mobileSlotsContainer = document.getElementById('booking-mobile-slots');

  const DAYS_PER_VIEW = 8;
  const TIME_STEP_MINUTES = 15;
  const SERVICE_HOURS = {
    tk_ek: { open: 7, close: 16 },
    ko: { open: 8, close: 15 }
  };

  let visibleDays = [];
  let allTimes = [];
  let slotMatrix = new Map();
  let currentStartDate = '';
  let selectedSlotId = null;
  let lastFocusedSlotButton = null;
  let activeMobileDayKey = null;
  const BOOKING_REQUEST_ID_KEY = 'booking-client-request-id';
  const i18nMessages = {
    sk: {
      selectedSlotPrefix: 'Vybraný termín:',
      selectedSlotNone: 'žiadny',
      free: 'VOĽNÉ',
      selected: 'vybrané ✓',
      time: 'Čas',
      slots: 'Termíny',
      noSlots: 'Aktuálne nie sú voľné termíny.',
      closed: 'ZATVORENÉ',
      pickSlotAria: 'Vybrať termín',
      busy: 'OBSADENÉ',
      loadSlotsError: 'Chyba pri načítaní termínov',
      loadSlotsFallbackError: 'Nepodarilo sa načítať termíny',
      detailsInspectionType: 'Typ kontroly',
      detailsControl: 'Kontrola',
      detailsVehicleType: 'Druh vozidla',
      detailsVehicleModel: 'Značka a typ vozidla',
      detailsFuelType: 'Druh paliva',
      slotRequired: 'Najprv vyberte voľný termín v tabuľke.',
      submitPending: 'Odosielam...',
      submitError: 'Rezerváciu sa nepodarilo odoslať',
      submitSuccess: 'Rezervácia bola odoslaná. Čoskoro vás budeme kontaktovať s potvrdením termínu.',
      submitIdle: 'Odoslať rezerváciu',
      recaptchaRequired: 'Nepodarilo sa overiť bezpečnostnú kontrolu reCAPTCHA.',
      recaptchaLoading: 'Prebieha bezpečnostné overenie...',
      koPhoneOnly: 'Kontrola originality (KO) je dostupná iba telefonicky na <a href="tel:+421948888088">0948 888 088</a>.',
      slotsUnavailablePhone: 'Online termíny sú dočasne nedostupné. Zavolajte prosím na <a href="tel:+421948888088">0948 888 088</a>.',
      mobileDayClosed: 'Tento deň je pracovisko zatvorené.',
      mobileNoSlotsDay: 'Pre vybraný deň momentálne nie sú voľné termíny.',
      mobileDaysAria: 'Dni termínov',
      pageTitle: 'Rezervácia termínu | STK JP Control Pezinok',
      pageDescription: 'Online rezervácia termínu pre technickú, emisnú kontrolu alebo kontrolu originality.'
    },
    en: {
      selectedSlotPrefix: 'Selected appointment:',
      selectedSlotNone: 'none',
      free: 'AVAILABLE',
      selected: 'selected ✓',
      time: 'Time',
      slots: 'Appointments',
      noSlots: 'There are currently no available appointments.',
      closed: 'CLOSED',
      pickSlotAria: 'Select appointment',
      busy: 'BUSY',
      loadSlotsError: 'Error while loading appointments',
      loadSlotsFallbackError: 'Failed to load appointments',
      detailsInspectionType: 'Inspection type',
      detailsControl: 'Inspection',
      detailsVehicleType: 'Vehicle type',
      detailsVehicleModel: 'Vehicle make and model',
      detailsFuelType: 'Fuel type',
      slotRequired: 'Please select a free appointment in the table first.',
      submitPending: 'Sending...',
      submitError: 'Failed to submit reservation',
      submitSuccess: 'Your reservation has been sent. We will contact you soon to confirm the appointment.',
      submitIdle: 'Submit reservation',
      recaptchaRequired: 'Security check via reCAPTCHA failed.',
      recaptchaLoading: 'Running security verification...',
      koPhoneOnly: 'Originality check (KO) can only be booked by phone at <a href="tel:+421948888088">0948 888 088</a>.',
      slotsUnavailablePhone: 'Online appointments are temporarily unavailable. Please call <a href="tel:+421948888088">0948 888 088</a>.',
      mobileDayClosed: 'The station is closed on this day.',
      mobileNoSlotsDay: 'There are currently no available appointments for the selected day.',
      mobileDaysAria: 'Appointment days',
      pageTitle: 'Appointment booking | STK JP Control Pezinok',
      pageDescription: 'Online appointment booking for technical inspection, emission test, or originality check.'
    }
  };

  function getLang() {
    const htmlLang = String(document.documentElement.lang || '').toLowerCase();
    if (htmlLang.startsWith('en')) return 'en';
    return localStorage.getItem('language') === 'en' ? 'en' : 'sk';
  }

  function t(key) {
    const lang = getLang();
    return i18nMessages[lang]?.[key] ?? i18nMessages.sk[key] ?? key;
  }

  function getOrCreateClientRequestId() {
    try {
      const existing = sessionStorage.getItem(BOOKING_REQUEST_ID_KEY);
      if (existing && existing.length >= 8) return existing;
      const generated = (window.crypto?.randomUUID?.() || `req-${Date.now()}-${Math.random().toString(36).slice(2, 12)}`)
        .replace(/[^a-zA-Z0-9._:-]/g, '')
        .slice(0, 80);
      sessionStorage.setItem(BOOKING_REQUEST_ID_KEY, generated);
      return generated;
    } catch {
      return `req-${Date.now()}-${Math.random().toString(36).slice(2, 12)}`.slice(0, 80);
    }
  }

  function resetClientRequestId() {
    try {
      sessionStorage.removeItem(BOOKING_REQUEST_ID_KEY);
    } catch {
      // ignore storage errors
    }
  }

  async function getRecaptchaToken() {
    if (!RECAPTCHA_SITE_KEY) return '';
    const recaptcha = window.grecaptcha;
    if (!recaptcha) return '';

    if (RECAPTCHA_MODE === 'v2') {
      if (typeof recaptcha.getResponse !== 'function') return '';
      return String(recaptcha.getResponse() || '').trim();
    }

    if (typeof recaptcha.ready !== 'function' || typeof recaptcha.execute !== 'function') {
      return '';
    }
    return new Promise((resolve) => {
      recaptcha.ready(() => {
        recaptcha
          .execute(RECAPTCHA_SITE_KEY, { action: 'booking_submit' })
          .then((token) => resolve(String(token || '').trim()))
          .catch(() => resolve(''));
      });
    });
  }

  function resetRecaptcha() {
    if (RECAPTCHA_MODE === 'v2' && window.grecaptcha && typeof window.grecaptcha.reset === 'function') {
      window.grecaptcha.reset();
    }
    // v3 is token-based per action, no widget reset is needed.
  }

  function getLocale() {
    return getLang() === 'en' ? 'en-GB' : 'sk-SK';
  }

  function openBookingModal() {
    if (!bookingModal) return;
    if (serviceTypeModal && serviceSelect) {
      const schedulerService = serviceSelect.value || 'tk_ek';
      if (schedulerService === 'ko') {
        serviceTypeModal.value = 'tk_ek';
      }
    }
    bookingModal.hidden = false;
    bookingModal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('booking-modal-open');
    window.setTimeout(() => {
      const nameInput = document.getElementById('name');
      if (nameInput) nameInput.focus();
    }, 0);
  }

  function closeBookingModal() {
    if (!bookingModal) return;
    bookingModal.hidden = true;
    bookingModal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('booking-modal-open');
    if (lastFocusedSlotButton) {
      lastFocusedSlotButton.focus();
    }
  }

  function setMessage(text, ok, allowHtml = false) {
    const targetMessages = [message, inlineMessage].filter(Boolean);
    if (!targetMessages.length) return;
    targetMessages.forEach((node) => {
      if (allowHtml) {
        node.innerHTML = text;
      } else {
        node.textContent = text;
      }
      node.className = ok ? 'booking-msg booking-msg--ok' : 'booking-msg booking-msg--error';
      node.hidden = false;
    });
  }

  function formatDayKey(value) {
    const date = new Date(value);
    const formatter = new Intl.DateTimeFormat('sv-SE', {
      timeZone: 'Europe/Bratislava',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit'
    });
    return formatter.format(date);
  }

  function formatDayLabel(dayKey) {
    const date = new Date(`${dayKey}T00:00:00`);
    const locale = getLocale();
    const weekday = new Intl.DateTimeFormat(locale, { weekday: 'short' }).format(date).toUpperCase();
    const formattedDate = new Intl.DateTimeFormat(locale, {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric'
    }).format(date);
    return `${formattedDate} ${weekday}`;
  }

  function formatTime(value) {
    const date = new Date(value);
    return new Intl.DateTimeFormat(getLocale(), {
      timeZone: 'Europe/Bratislava',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false
    }).format(date);
  }

  function getTodayDayKey() {
    return formatDayKey(new Date().toISOString());
  }

  function sanitizeDayKey(value) {
    if (typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value)) {
      const parsed = new Date(`${value}T00:00:00`);
      if (!Number.isNaN(parsed.getTime())) {
        return value;
      }
    }
    return getTodayDayKey();
  }

  function shiftDayKey(dayKey, shiftByDays) {
    const date = new Date(`${dayKey}T00:00:00`);
    date.setDate(date.getDate() + shiftByDays);
    return formatDayKey(date.toISOString());
  }

  function buildVisibleDays(startDayKey, count) {
    const days = [];
    for (let i = 0; i < count; i += 1) {
      days.push(shiftDayKey(startDayKey, i));
    }
    return days;
  }

  function parseTimeToMinutes(timeKey) {
    const [hours, minutes] = String(timeKey).split(':').map((part) => Number(part));
    if (!Number.isInteger(hours) || !Number.isInteger(minutes)) return null;
    return hours * 60 + minutes;
  }

  function minutesToTime(totalMinutes) {
    const hours = Math.floor(totalMinutes / 60);
    const minutes = totalMinutes % 60;
    return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;
  }

  function buildDefaultTimeGrid(serviceType) {
    const hours = SERVICE_HOURS[serviceType] || SERVICE_HOURS.tk_ek;
    const min = hours.open * 60;
    const max = hours.close * 60;
    const times = [];
    for (let value = min; value <= max; value += TIME_STEP_MINUTES) {
      times.push(minutesToTime(value));
    }
    return times;
  }

  function buildTimeGrid(serviceType) {
    const predefined = buildDefaultTimeGrid(serviceType);
    const fromSlots = Array.from(
      new Set(Array.from(slotMatrix.values()).flatMap((dayMap) => Array.from(dayMap.keys())))
    );
    const all = new Set([...predefined, ...fromSlots]);
    return Array.from(all).sort((a, b) => {
      const left = parseTimeToMinutes(a) ?? 0;
      const right = parseTimeToMinutes(b) ?? 0;
      return left - right;
    });
  }

  function buildClientMockSlots(serviceType) {
    const times = buildDefaultTimeGrid(serviceType);
    const slots = [];
    visibleDays.forEach((dayKey) => {
      if (isWeekend(dayKey)) return;
      times.forEach((timeKey) => {
        const startAt = new Date(`${dayKey}T${timeKey}:00`);
        const slotId = `ui-mock-${dayKey}-${timeKey.replace(':', '')}-${serviceType}`;
        slots.push({
          id: slotId,
          startAt: startAt.toISOString(),
          endAt: new Date(startAt.getTime() + TIME_STEP_MINUTES * 60 * 1000).toISOString(),
          available: true
        });
      });
    });
    return slots;
  }

  function updateSelectedSlotLabel(label) {
    if (!selectedSlotText) return;
    selectedSlotText.textContent = label ? `${t('selectedSlotPrefix')} ${label}` : `${t('selectedSlotPrefix')} ${t('selectedSlotNone')}`;
    selectedSlotText.classList.toggle('selected-slot--active', Boolean(label));
  }

  function findSelectedSlot() {
    if (!selectedSlotId) return null;
    for (const dayMap of slotMatrix.values()) {
      for (const slot of dayMap.values()) {
        if (slot?.id === selectedSlotId) return slot;
      }
    }
    return null;
  }

  function syncLanguageSensitiveUi() {
    const selectedSlot = findSelectedSlot();
    if (selectedSlot) {
      updateSelectedSlotLabel(selectedSlot.label || `${formatDayKey(selectedSlot.startAt)} ${formatTime(selectedSlot.startAt)}`);
    } else {
      updateSelectedSlotLabel('');
    }
    updateRangeLabel();
    renderTable();
    if (submitBtn && !submitBtn.disabled) {
      submitBtn.textContent = t('submitIdle');
    }
    document.title = t('pageTitle');
    const metaDescription = document.querySelector('meta[name="description"]');
    if (metaDescription) {
      metaDescription.setAttribute('content', t('pageDescription'));
    }
  }

  function selectSlot(slot, btn) {
    lastFocusedSlotButton = btn;
    selectedSlotId = slot.id;
    if (slotInput) slotInput.value = slot.id;
    if (slotStartInput) slotStartInput.value = slot.startAt || '';
    updateSelectedSlotLabel(slot.label || `${formatDayKey(slot.startAt)} ${formatTime(slot.startAt)}`);

    tableBody.querySelectorAll('.booking-slot-btn').forEach((node) => {
      node.classList.remove('is-selected');
      node.textContent = t('free');
    });
    tableBody.querySelectorAll('.booking-cell').forEach((node) => node.classList.remove('booking-cell--selected'));
    btn.classList.add('is-selected');
    btn.textContent = t('selected');
    const selectedCell = btn.closest('td');
    if (selectedCell) {
      selectedCell.classList.add('booking-cell--selected', 'booking-cell--pulse');
      window.setTimeout(() => {
        selectedCell.classList.remove('booking-cell--pulse');
      }, 520);
    }
    renderMobileSchedule();
    openBookingModal();
  }

  function updateRangeLabel() {
    if (!currentRangeLabel || !visibleDays.length) return;
    const first = visibleDays[0];
    const last = visibleDays[visibleDays.length - 1];
    currentRangeLabel.textContent = `${formatDayLabel(first).slice(0, 10)} - ${formatDayLabel(last).slice(0, 10)}`;
  }

  function renderMobileSchedule() {
    if (!mobileDaysContainer || !mobileSlotsContainer) return;

    mobileDaysContainer.innerHTML = '';
    mobileSlotsContainer.innerHTML = '';
    mobileDaysContainer.setAttribute('aria-label', t('mobileDaysAria'));

    if (!visibleDays.length) {
      mobileSlotsContainer.innerHTML = `<p class="booking-mobile-empty">${t('mobileNoSlotsDay')}</p>`;
      return;
    }

    if (!activeMobileDayKey || !visibleDays.includes(activeMobileDayKey)) {
      activeMobileDayKey = visibleDays[0];
    }

    visibleDays.forEach((dayKey) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'booking-mobile-day-btn';
      btn.setAttribute('role', 'tab');
      const isActive = dayKey === activeMobileDayKey;
      btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
      btn.classList.toggle('is-active', isActive);
      btn.textContent = formatDayLabel(dayKey);
      btn.addEventListener('click', () => {
        activeMobileDayKey = dayKey;
        renderMobileSchedule();
      });
      mobileDaysContainer.appendChild(btn);
    });

    if (isWeekend(activeMobileDayKey)) {
      mobileSlotsContainer.innerHTML = `<p class="booking-mobile-empty">${t('mobileDayClosed')}</p>`;
      return;
    }

    const dayMap = slotMatrix.get(activeMobileDayKey) || new Map();
    const dayAvailableSlots = Array.from(dayMap.values())
      .filter((slot) => slot?.available !== false)
      .sort((a, b) => {
        const left = parseTimeToMinutes(formatTime(a.startAt)) ?? 0;
        const right = parseTimeToMinutes(formatTime(b.startAt)) ?? 0;
        return left - right;
      });

    if (!dayAvailableSlots.length) {
      mobileSlotsContainer.innerHTML = `<p class="booking-mobile-empty">${t('mobileNoSlotsDay')}</p>`;
      return;
    }

    const list = document.createElement('div');
    list.className = 'booking-mobile-slot-list';

    dayAvailableSlots.forEach((slot) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'booking-mobile-slot-btn';
      button.textContent = formatTime(slot.startAt);
      if (selectedSlotId && selectedSlotId === slot.id) {
        button.classList.add('is-selected');
        button.textContent = `${formatTime(slot.startAt)} · ${t('selected')}`;
      }
      button.addEventListener('click', () => selectSlot(slot, button));
      list.appendChild(button);
    });

    mobileSlotsContainer.appendChild(list);
  }

  function isWeekend(dayKey) {
    const date = new Date(`${dayKey}T00:00:00`);
    const day = date.getDay();
    return day === 0 || day === 6;
  }

  function renderTable() {
    if (!tableHead || !tableBody) return;
    tableHead.innerHTML = '';
    tableBody.innerHTML = '';

    if (!visibleDays.length || !allTimes.length) {
      const headRow = document.createElement('tr');
      headRow.innerHTML = `<th>${t('time')}</th><th>${t('slots')}</th>`;
      tableHead.appendChild(headRow);
      const row = document.createElement('tr');
      row.innerHTML = `<td>--</td><td class="booking-empty-cell">${t('noSlots')}</td>`;
      tableBody.appendChild(row);
      renderMobileSchedule();
      return;
    }

    const headRow = document.createElement('tr');
    const timeTh = document.createElement('th');
    timeTh.textContent = t('time');
    headRow.appendChild(timeTh);
    visibleDays.forEach((day) => {
      const th = document.createElement('th');
      th.textContent = formatDayLabel(day);
      headRow.appendChild(th);
    });
    tableHead.appendChild(headRow);

    allTimes.forEach((timeKey) => {
      const tr = document.createElement('tr');
      const timeCell = document.createElement('td');
      timeCell.className = 'booking-time-cell';
      timeCell.textContent = timeKey;
      tr.appendChild(timeCell);

      visibleDays.forEach((dayKey) => {
        const td = document.createElement('td');
        td.className = 'booking-cell';
        const dayMap = slotMatrix.get(dayKey) || new Map();
        const slot = dayMap.get(timeKey) || null;
        const weekend = isWeekend(dayKey);

        if (weekend) {
          td.classList.add('booking-cell--closed');
          const span = document.createElement('span');
          span.className = 'booking-slot-closed';
          span.textContent = t('closed');
          td.appendChild(span);
        } else if (slot && slot.available !== false) {
          td.classList.add('booking-cell--free');
          td.classList.add('booking-cell--clickable');
          td.setAttribute('aria-label', `${t('pickSlotAria')} ${formatDayLabel(dayKey)} ${timeKey}`);
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'booking-slot-btn';
          btn.textContent = t('free');
          btn.addEventListener('click', (event) => {
            event.stopPropagation();
            selectSlot(slot, btn);
          });
          td.addEventListener('click', () => selectSlot(slot, btn));
          if (selectedSlotId && selectedSlotId === slot.id) {
            btn.classList.add('is-selected');
            btn.textContent = t('selected');
            td.classList.add('booking-cell--selected');
          }
          td.appendChild(btn);
        } else {
          td.classList.add('booking-cell--occupied');
          const span = document.createElement('span');
          span.className = 'booking-slot-occupied';
          span.textContent = t('busy');
          td.appendChild(span);
        }

        tr.appendChild(td);
      });

      tableBody.appendChild(tr);
    });
    renderMobileSchedule();
  }

  async function loadSlots() {
    if (!serviceSelect || !rangeStartInput) return;
    allTimes = [];
    slotMatrix = new Map();
    selectedSlotId = null;
    if (slotInput) slotInput.value = '';
    if (slotStartInput) slotStartInput.value = '';
    updateSelectedSlotLabel('');

    const serviceType = serviceSelect.value || 'tk_ek';
    currentStartDate = sanitizeDayKey(rangeStartInput.value || currentStartDate || getTodayDayKey());
    visibleDays = buildVisibleDays(currentStartDate, DAYS_PER_VIEW);
    activeMobileDayKey = visibleDays[0] || null;
    rangeStartInput.value = currentStartDate;
    updateRangeLabel();

    try {
      const res = await fetch(
        `/api/booking/slots?serviceType=${encodeURIComponent(serviceType)}&days=${DAYS_PER_VIEW}&startDate=${encodeURIComponent(currentStartDate)}`
      );
      const data = await res.json();
      if (!res.ok) {
        if (res.status === 503) {
          throw new Error('__PHONE_FALLBACK__');
        }
        throw new Error(data?.detail || data?.error || t('loadSlotsError'));
      }

      const slots = Array.isArray(data?.slots) ? data.slots : [];
      slots.forEach((slot) => {
        if (!slot?.startAt) return;
        const dayKey = formatDayKey(slot.startAt);
        const timeKey = formatTime(slot.startAt);
        if (!slotMatrix.has(dayKey)) slotMatrix.set(dayKey, new Map());
        slotMatrix.get(dayKey).set(timeKey, slot);
      });

      allTimes = buildTimeGrid(serviceType);
      renderTable();
    } catch (error) {
      const fallbackSlots = buildClientMockSlots(serviceType);
      fallbackSlots.forEach((slot) => {
        const dayKey = formatDayKey(slot.startAt);
        const timeKey = formatTime(slot.startAt);
        if (!slotMatrix.has(dayKey)) slotMatrix.set(dayKey, new Map());
        slotMatrix.get(dayKey).set(timeKey, slot);
      });
      allTimes = buildTimeGrid(serviceType);
      renderTable();
      if (error?.message === '__PHONE_FALLBACK__') {
        setMessage(t('slotsUnavailablePhone'), false, true);
      } else {
        setMessage(error?.message || t('loadSlotsFallbackError'), false);
      }
    }
  }

  serviceSelect?.addEventListener('change', loadSlots);
  rangeStartInput?.addEventListener('change', loadSlots);
  prevRangeBtn?.addEventListener('click', () => {
    currentStartDate = sanitizeDayKey(rangeStartInput?.value || currentStartDate || getTodayDayKey());
    rangeStartInput.value = shiftDayKey(currentStartDate, -DAYS_PER_VIEW);
    loadSlots();
  });
  nextRangeBtn?.addEventListener('click', () => {
    currentStartDate = sanitizeDayKey(rangeStartInput?.value || currentStartDate || getTodayDayKey());
    rangeStartInput.value = shiftDayKey(currentStartDate, DAYS_PER_VIEW);
    loadSlots();
  });

  bookingModalClose?.addEventListener('click', closeBookingModal);
  bookingModalBackdrop?.addEventListener('click', closeBookingModal);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeBookingModal();
  });
  bookingModalDialog?.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab' || bookingModal?.hidden) return;
    const focusable = bookingModalDialog.querySelectorAll(
      'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
    );
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  if (rangeStartInput) {
    currentStartDate = sanitizeDayKey(rangeStartInput.value || getTodayDayKey());
    rangeStartInput.value = currentStartDate;
  }

  loadSlots();
  syncLanguageSensitiveUi();

  const languageObserver = new MutationObserver(() => {
    syncLanguageSensitiveUi();
  });
  languageObserver.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['lang']
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !submitBtn || !slotInput || !slotStartInput) return;
    if (message) message.hidden = true;
    if (inlineMessage) inlineMessage.hidden = true;
    const inspectionType = String(form.inspectionType?.value || '').trim();
    const controlLabel = String(form.serviceTypeModal?.selectedOptions?.[0]?.textContent || '').trim();
    const vehicleType = String(form.vehicleType?.value || '').trim();
    const vehicleModel = String(form.vehicleModel?.value || '').trim();
    const fuelType = String(form.fuelType?.value || '').trim();
    const baseNote = String(form.note.value || '').trim();
    const extraDetails = [
      controlLabel ? `${t('detailsControl')}: ${controlLabel}` : null,
      inspectionType ? `${t('detailsInspectionType')}: ${inspectionType}` : null,
      vehicleType ? `${t('detailsVehicleType')}: ${vehicleType}` : null,
      vehicleModel ? `${t('detailsVehicleModel')}: ${vehicleModel}` : null,
      fuelType ? `${t('detailsFuelType')}: ${fuelType}` : null
    ].filter(Boolean);
    const combinedNoteRaw = [baseNote, extraDetails.length ? `---\n${extraDetails.join('\n')}` : '']
      .filter(Boolean)
      .join('\n\n')
      .trim();
    const combinedNote = combinedNoteRaw.slice(0, 1000);

    if (RECAPTCHA_SITE_KEY && RECAPTCHA_MODE === 'v3') {
      submitBtn.textContent = t('recaptchaLoading');
    }
    const recaptchaToken = await getRecaptchaToken();

    const payload = {
      serviceType: serviceSelect?.value || 'tk_ek',
      slotId: slotInput.value,
      slotStartAt: slotStartInput.value || null,
      name: String(form.name.value || '').trim(),
      phone: String(form.phone.value || '').trim(),
      email: String(form.email.value || '').trim(),
      vehiclePlate: String(form.vehiclePlate.value || '').trim(),
      vehicleVin: String(form.vehicleVin.value || '').trim(),
      note: combinedNote,
      clientRequestId: getOrCreateClientRequestId(),
      recaptchaToken
    };

    if (!payload.slotId) {
      setMessage(t('slotRequired'), false);
      return;
    }
    if (payload.serviceType === 'ko') {
      setMessage(t('koPhoneOnly'), false, true);
      return;
    }
    if (RECAPTCHA_SITE_KEY && !payload.recaptchaToken) {
      setMessage(t('recaptchaRequired'), false);
      submitBtn.disabled = false;
      submitBtn.textContent = t('submitIdle');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = t('submitPending');

    try {
      const res = await fetch('/api/booking/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        if (res.status === 503) {
          throw new Error('__PHONE_FALLBACK__');
        }
        const msg = data?.errors?.join(' ') || data?.detail || data?.error || t('submitError');
        throw new Error(msg);
      }

      form.reset();
      resetClientRequestId();
      resetRecaptcha();
      await loadSlots();
      setMessage(t('submitSuccess'), true);
      closeBookingModal();
    } catch (error) {
      if (error?.message === '__PHONE_FALLBACK__') {
        setMessage(t('slotsUnavailablePhone'), false, true);
      } else {
        setMessage(error?.message || t('submitError'), false);
      }
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = t('submitIdle');
    }
  });
</script>

