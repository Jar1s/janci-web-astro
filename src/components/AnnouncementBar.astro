---
// AnnouncementBar - loads notifications from API and displays scrolling text
---

<div class="announcement-bar" id="announcement-bar" style="display: none;" role="status" aria-live="polite">
  <div class="announcement-track" id="announcement-track"></div>
</div>

<style>
  .announcement-bar {
    position: fixed;
    top: var(--navbar-height, 64px);
    left: 0;
    width: 100%;
    z-index: 999;
    background: linear-gradient(135deg, rgba(200, 30, 30, 0.95), rgba(180, 20, 20, 0.95));
    backdrop-filter: blur(8px);
    color: #fff;
    overflow: hidden;
    height: 44px;
    display: flex;
    align-items: center;
    transition: opacity 0.2s ease;
  }

  .announcement-track {
    display: flex;
    align-items: center;
    white-space: nowrap;
    width: fit-content;
    will-change: transform;
    gap: 4rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .announcement-track.is-running {
    animation: scroll-announcement var(--announcement-duration, 90s) linear infinite;
  }

  .announcement-track.is-running:hover {
    animation-play-state: paused;
  }

  .announcement-item {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  @keyframes scroll-announcement {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media (max-width: 768px) {
    .announcement-bar {
      top: var(--navbar-height, 55px);
      height: 40px;
    }
    .announcement-track {
      font-size: 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-track.is-running {
      animation-duration: 0.01ms;
      animation-iteration-count: 1;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const bar = document.getElementById('announcement-bar');
    const track = document.getElementById('announcement-track');
    if (!bar || !track) return;

    try {
      const res = await fetch('/api/notifications');
      if (!res.ok) throw new Error('API error');
      const data = await res.json();

      // Filter active notifications
      const active = Array.isArray(data)
        ? data.filter((n: any) => n.active !== false)
        : (data.notifications || []).filter((n: any) => n.active !== false);

      if (!active.length) return;

      // Build scrolling content - duplicate for seamless loop
      const texts = active.map((n: any) => n.text || n.message || '').filter(Boolean);
      if (!texts.length) return;

      const createItem = (text) => {
        const item = document.createElement('span');
        item.className = 'announcement-item';
        item.textContent = text;
        return item;
      };

      // Build one sequence, repeat until wide enough, then duplicate for seamless loop.
      track.textContent = '';
      const appendSequence = () => {
        texts.forEach((text) => track.appendChild(createItem(text)));
      };
      appendSequence();

      const viewportWidth = bar.offsetWidth || window.innerWidth;
      let repeats = 1;
      const maxRepeats = 6;
      while (track.scrollWidth < viewportWidth * 1.5 && repeats < maxRepeats) {
        appendSequence();
        repeats += 1;
      }

      const nodes = Array.from(track.children);
      nodes.forEach((node) => track.appendChild(node.cloneNode(true)));

      const loopWidth = Math.max(track.scrollWidth / 2, 1);
      // ~45s to scroll one screen width; never faster than ~18px/s
      const secondsPerViewport = 45;
      const duration = Math.max(
        90,
        Math.min(300, (loopWidth / viewportWidth) * secondsPerViewport)
      );
      const durationValue = `${duration}s`;
      track.style.setProperty('--announcement-duration', durationValue);
      track.style.animationDuration = durationValue;

      // Apply custom styles from first notification
      const first = active[0];
      if (first.backgroundColor) bar.style.background = first.backgroundColor;
      if (first.backgroundGradient) bar.style.background = first.backgroundGradient;
      if (first.textColor) bar.style.color = first.textColor;
      if (first.borderColor) bar.style.borderBottom = `1px solid ${first.borderColor}`;

      bar.style.display = 'flex';
      track.classList.remove('is-running');
      // Force reflow so animation restarts cleanly after content changes.
      void track.offsetWidth;
      track.classList.add('is-running');

      // Keep global layout offsets in sync with the actual rendered bar.
      const barHeight = Math.ceil(bar.offsetHeight || 44);
      document.documentElement.style.setProperty('--announcement-height', `${barHeight}px`);
      document.documentElement.style.setProperty('--header-total-height', `calc(var(--navbar-height) + ${barHeight}px)`);
    } catch (e) {
      // API not available, hide bar silently
      bar.style.display = 'none';
    }
  });
</script>
