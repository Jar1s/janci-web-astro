---
// AnnouncementBar - loads notifications from API and displays scrolling text
---

<div class="announcement-bar" id="announcement-bar" style="display: none;" role="status" aria-live="polite">
  <div class="announcement-viewport">
    <div class="announcement-track" id="announcement-track"></div>
  </div>
</div>

<style>
  .announcement-bar {
    position: fixed;
    top: var(--navbar-height, 64px);
    left: 0;
    width: 100%;
    z-index: 999;
    background: linear-gradient(135deg, rgba(200, 30, 30, 0.95), rgba(180, 20, 20, 0.95));
    backdrop-filter: blur(8px);
    color: #fff;
    overflow: hidden;
    min-height: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    transition: opacity 0.2s ease;
    box-sizing: border-box;
  }

  .announcement-viewport {
    flex: 1;
    min-width: 0;
    width: 100%;
    overflow: hidden;
  }

  .announcement-track {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    width: max-content;
    will-change: transform;
    gap: 3rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding-right: 3rem;
  }

  .announcement-track.is-running {
    animation: scroll-announcement var(--announcement-duration, 90s) linear infinite;
  }

  .announcement-track.is-running:hover {
    animation-play-state: paused;
  }

  .announcement-item {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .announcement-item::after {
    content: '•';
    margin-left: 3rem;
    opacity: 0.65;
  }

  .announcement-item:last-child::after {
    content: none;
    margin: 0;
  }

  @keyframes scroll-announcement {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-50%, 0, 0); }
  }

  /* Desktop: fixed under navbar. Mobile: flows inside .site-top (see enhancements.css). */
  @media (max-width: 768px) {
    .announcement-bar {
      position: relative;
      top: auto;
      left: auto;
      right: auto;
      margin: 0;
      z-index: 1;
      width: 100%;
      min-height: 42px;
      height: auto;
      padding: 0.55rem 0;
    }

    .announcement-track {
      font-size: 0.8125rem;
      gap: 2rem;
      padding-right: 2rem;
    }

    .announcement-item::after {
      margin-left: 2rem;
    }
  }

  @media (prefers-reduced-div: reduce) {
    .announcement-track.is-running {
      animation-duration: 0.01ms;
      animation-iteration-count: 1;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const bar = document.getElementById('announcement-bar');
    const track = document.getElementById('announcement-track');
    if (!bar || !track) return;

    const mobileMq = window.matchMedia('(max-width: 768px)');

    function requestLayoutSync() {
      window.dispatchEvent(new Event('janci:layout-sync'));
    }

    function measureSiteTop() {
      const siteTop = document.getElementById('site-top');
      if (!siteTop || !mobileMq.matches) return;
      const total = Math.ceil(siteTop.getBoundingClientRect().height);
      if (total > 0) {
        document.documentElement.style.setProperty('--site-top-height', `${total}px`);
        document.documentElement.style.setProperty('--header-total-height', `${total}px`);
      }
    }

    function syncLayoutOffsets(barHeight, visible) {
      const annH = visible ? barHeight : 0;
      document.documentElement.style.setProperty('--announcement-height', `${annH}px`);
      document.body.classList.toggle('has-announcement-bar', visible);

      if (mobileMq.matches) {
        measureSiteTop();
        return;
      }

      document.documentElement.style.setProperty(
        '--header-total-height',
        `calc(var(--navbar-height) + ${annH}px)`
      );
    }

    mobileMq.addEventListener('change', () => {
      requestLayoutSync();
      if (bar.style.display === 'none') {
        syncLayoutOffsets(0, false);
        return;
      }
      requestAnimationFrame(() => {
        syncLayoutOffsets(Math.ceil(bar.offsetHeight || 44), true);
      });
    });

    try {
      const res = await fetch('/api/notifications');
      if (!res.ok) throw new Error('API error');
      const data = await res.json();

      const active = Array.isArray(data)
        ? data.filter((n: any) => n.active !== false)
        : (data.notifications || []).filter((n: any) => n.active !== false);

      if (!active.length) return;

      const texts = active.map((n: any) => n.text || n.message || '').filter(Boolean);
      if (!texts.length) return;

      const createItem = (text) => {
        const item = document.createElement('span');
        item.className = 'announcement-item';
        item.textContent = text;
        return item;
      };

      track.textContent = '';
      const appendSequence = () => {
        texts.forEach((text) => track.appendChild(createItem(text)));
      };
      appendSequence();

      const viewport = bar.querySelector('.announcement-viewport');
      const viewportWidth = viewport?.clientWidth || bar.clientWidth || window.innerWidth;
      let repeats = 1;
      const maxRepeats = 6;
      while (track.scrollWidth < viewportWidth * 2 && repeats < maxRepeats) {
        appendSequence();
        repeats += 1;
      }

      const nodes = Array.from(track.children);
      nodes.forEach((node) => track.appendChild(node.cloneNode(true)));

      const loopWidth = Math.max(track.scrollWidth / 2, 1);
      const secondsPerViewport = mobileMq.matches ? 55 : 45;
      const duration = Math.max(
        90,
        Math.min(300, (loopWidth / viewportWidth) * secondsPerViewport)
      );
      const durationValue = `${duration}s`;
      track.style.setProperty('--announcement-duration', durationValue);
      track.style.animationDuration = durationValue;

      const first = active[0];
      if (first.backgroundColor) bar.style.background = first.backgroundColor;
      if (first.backgroundGradient) bar.style.background = first.backgroundGradient;
      if (first.textColor) bar.style.color = first.textColor;
      if (first.borderColor) bar.style.borderBottom = `1px solid ${first.borderColor}`;

      bar.style.display = 'flex';
      track.classList.remove('is-running');
      void track.offsetWidth;
      track.classList.add('is-running');

      requestAnimationFrame(() => {
        requestLayoutSync();
        requestAnimationFrame(() => {
          const barHeight = Math.ceil(bar.offsetHeight || 44);
          syncLayoutOffsets(barHeight, true);
        });
      });
    } catch (e) {
      bar.style.display = 'none';
      syncLayoutOffsets(0, false);
    }
  });
</script>
